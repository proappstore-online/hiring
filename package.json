{
  "name": "hiring",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @hiring/web dev",
    "prebuild": "npx -y @proappstore/cli@latest check",
    "build": "pnpm --filter @hiring/web build",
    "preview": "pnpm --filter @hiring/web preview",
    "dev:marketing": "pnpm --filter @hiring/marketing dev",
    "build:marketing": "pnpm --filter @hiring/marketing build",
    "typecheck": "pnpm --filter @hiring/web exec tsc -b",
    "test": "pnpm --filter @hiring/web exec tsc -b && node --test tests/*.test.mjs"
  }
}
