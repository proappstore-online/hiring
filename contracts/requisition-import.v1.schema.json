{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hiring:requisition-import:v1",
  "title": "Public job draft import rows; candidate information prohibited",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "title"],
    "properties": {
      "source_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
      "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }
    }
  }
}
